# --- LLM de todos los agentes: "openai" | "anthropic" | "gemini" | "openrouter" ---
LLM_PROVIDER="openrouter"
# Opcional: pisa el modelo por defecto del provider (ver DEFAULT_MODEL_POR_PROVIDER en app/config.py).
LLM_MODEL="openai/gpt-4.1-mini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
# Tope de tokens de salida por llamada (evita que el proveedor reserve el máximo del modelo)
LLM_MAX_TOKENS="2048"
# Opcional: tope de requests/minuto al LLM, compartido por todos los jobs (ej. 14 para el free tier de Gemini).
# Vacío = sin límite.
LLM_REQUESTS_PER_MINUTE=""

# --- Opcional: búsqueda web para el investigador (sin esta key usa solo la base de conocimiento local) ---
TAVILY_API_KEY=""

# --- Redis (estado de los jobs, cola de trabajo y checkpoints de LangGraph). Requiere Redis Stack. ---
REDIS_URL="redis://localhost:6379/0"

# --- Worker ---
# true: el worker corre dentro del proceso de la API. false: correr aparte con `python -m app.worker`.
RUN_WORKER_IN_API="true"
# Cantidad de jobs que se ejecutan en paralelo (corrutinas consumidoras de la cola)
WORKER_CONCURRENCY="5"
# Tiempo máximo por ejecución del grafo; al superarlo el job pasa a FAILED
JOB_TIMEOUT_SECONDS="300"

# --- Observabilidad: Arize Phoenix (UI en http://localhost:6006) ---
PHOENIX_ENABLED="true"
PHOENIX_COLLECTOR_ENDPOINT="http://localhost:6006"
PHOENIX_PROJECT_NAME="genpet-multiagente"
